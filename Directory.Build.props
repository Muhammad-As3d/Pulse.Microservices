<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <!-- Pin the patched 2.x line used transitively by Microsoft.AspNetCore.OpenApi. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'BuildingBlocks'">
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>
</Project>
